{
  "name": "ventijs",
  "version": "0.0.0",
  "description": "A high-performance, drop-in replacement for ws, built on the first-party µWebZockets Zig engine via napi-zig.",
  "homepage": "https://github.com/farbenbuilds/ventijs#readme",
  "bugs": {
    "url": "https://github.com/farbenbuilds/ventijs/issues"
  },
  "license": "MIT",
  "author": "Noah Trần (https://github.com/Coder-Blue)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farbenbuilds/ventijs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:binding && tsdown && pnpm run typecheck:dist",
    "build:binding": "napi-zig build --optimize safe",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm run build:binding && vitest run",
    "test:watch": "pnpm run build:binding && vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:dist": "tsc -p tsconfig.dist-types.json",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "lefthook": "^2.1.14",
    "napi-zig": "^0.2.8",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
