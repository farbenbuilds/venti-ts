  "description": "A high-performance, drop-in replacement for ws, built on the µWebZockets Zig engine via napi-zig.",
  "author": "Noah Trần (https://github.com/Coder-Blue)",
  "license": "MIT",
  "homepage": "https://github.com/farbenbuilds/venti-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farbenbuilds/venti-ts.git"
  },
  "bugs": {
    "url": "https://github.com/farbenbuilds/venti-ts/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
